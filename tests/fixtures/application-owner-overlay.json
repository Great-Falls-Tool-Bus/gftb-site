{
	"$schema": "../../docs/schemas/application-owner-overlay.schema.json",
	"schema_version": 1,
	"application_source": {
		"repository": "example/example-application",
		"role": "app-stateful-spoke",
		"default_branch": "main",
		"artifact_workflow": ".github/workflows/publish-image.yml"
	},
	"owner_overlay": {
		"repository": "example/example-application-infra",
		"authority_class": "application-owner-overlay",
		"binding_status": "declared"
	},
	"application_binding": {
		"source_repository": "example/example-application",
		"source_role": "app-stateful-spoke",
		"application_slug": "example-application",
		"default_branch": "main",
		"artifact_repository": "ghcr.io/example-publisher/releases/example-application",
		"artifact_workflow": ".github/workflows/publish-image.yml"
	},
	"capabilities": {
		"owns_application_image_pins": true,
		"owns_application_state": true,
		"owns_secret_declarations": true,
		"owns_application_workloads": true,
		"owns_protected_plan_apply": true,
		"owns_reaping": true,
		"owns_runtime_receipts": true,
		"owns_application_zone_dns": false,
		"owns_application_database": false,
		"owns_application_mail_policy": false
	},
	"shared_substrates": {
		"cluster": {
			"repository": "example/shared-cluster",
			"authority_class": "consumer-neutral-cluster-substrate"
		},
		"execution_products": {
			"repository": "example/shared-execution-products",
			"authority_class": "reusable-execution-products"
		},
		"host_policy": {
			"repository": "example/shared-host-policy",
			"authority_class": "host-policy-and-credential-projection"
		}
	}
}
