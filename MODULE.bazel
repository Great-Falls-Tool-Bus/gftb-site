"""Bazel module graph for the Great Falls Tool Bus static microsite."""

module(
    name = "gftb_site",
    version = "1.0.0",
    compatibility_level = 1,
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "rules_pkg", version = "1.1.0")
bazel_dep(name = "rules_multitool", version = "1.11.1")
# rules_pkg pulls the hermetic rules_python interpreter; the publisher's
# isolated Linux environment runs as root, and only the root module may lift
# the rules_python root-user refusal (see rules_python#713).
bazel_dep(name = "rules_python", version = "1.0.0")
bazel_dep(name = "rules_nodejs", version = "6.7.3")
bazel_dep(name = "aspect_rules_js", version = "2.9.1")
bazel_dep(name = "aspect_rules_ts", version = "3.10.1")

# First-party Vite plugin, graph-linked in BUILD.bazel rather than through npm.
# 1.0.0 (RU1/RU9): exact peers svelte 5.57.2 and vite 8.3.3 plus magic-string,
# all supplied by this app's own lock; the module links no packages itself.
bazel_dep(name = "tummycrypt_vite_plugin_a11y", version = "1.0.0")

# First-party brand-blob background (TinyVectors), graph-linked in BUILD.bazel
# rather than through npm. 0.3.7 is the idle-drift floor: the first release
# whose physics loop cruises the blobs on every idle desktop by default
# (src/lib/brand-vectors-motion-contract.test.ts pins it). 1.0.0 is the RU1
# re-cut of 0.3.7 (same API and physics, exact svelte 5.57.2 peer).
bazel_dep(name = "tummycrypt_tinyvectors", version = "1.0.0")

# Both first-party modules resolve inside this module graph (R574, TIN-7477).
# Bazel's default registry, bcr.bazel.build, serves every other module, so any
# invocation finds the whole graph from MODULE.bazel and MODULE.bazel.lock
# alone: no --registry flag, and nothing read from an rc file. That includes
# the GloriousFlywheel source preparation, which runs Bazel with
# --ignore_all_rc_files. Each override names an immutable commit of
# xoxd-ai/bazel-registry (the canonical home of the former
# tinyland-inc/bazel-registry), so module metadata cannot change under the
# lock. Bump both SHAs together, deliberately, then run `just module-lock`.
single_version_override(
    module_name = "tummycrypt_tinyvectors",
    registry = "https://raw.githubusercontent.com/xoxd-ai/bazel-registry/e912ea7e26b19f412b2daf4c67d363bb2475ea8a",
)

single_version_override(
    module_name = "tummycrypt_vite_plugin_a11y",
    registry = "https://raw.githubusercontent.com/xoxd-ai/bazel-registry/e912ea7e26b19f412b2daf4c67d363bb2475ea8a",
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.11",
    is_default = True,
    ignore_root_user_error = True,
)

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
# Node 22.22.0: SvelteKit 3 requires Node >= 22.17 (engines in package.json);
# 22.22.0 is the newest 22.x that rules_nodejs 6.7.3 knows.
#
# R576/R581 (TIN-7477): Node comes from one admitted origin only, the
# xoxd-ai/bazel-payloads mirror served raw at a 40-hex commit. The sha256 of
# each archive is rules_nodejs' own table entry, so the mirror changes the
# URL and never the bytes. It must stay the only entry: the GFTB cell checks
# every URL in the list before it tries any, so a nodejs.org fallback would
# fail the whole download there.
#
# PLACEHOLDER COMMIT: 0000000000000000000000000000000000000000 stands in for
# the PR-P2 merge commit of xoxd-ai/bazel-payloads, which does not exist yet.
# It is replaced by that commit before this change leaves DRAFT, and the
# one-payload-commit contract test then requires it to equal the commit in
# the P0 and P1 source.json URLs.
node.toolchain(
    node_urls = ["https://raw.githubusercontent.com/xoxd-ai/bazel-payloads/0000000000000000000000000000000000000000/node/v{version}/{filename}"],
    node_version = "22.22.0",
)

# R575/R577 (TIN-7477): the pnpm lock and its inputs live in the P0 payload
# module, and the 160 packages of the //:lint_suite closure come from the P1
# payload module. Both are sha256-pinned module archives in
# xoxd-ai/bazel-payloads, resolved through xoxd-ai/bazel-registry like the two
# tummycrypt modules, so npm is read once, at publish time, and never by a
# build. Bump them only together with a new payload commit, then run
# `just module-lock`.
bazel_dep(name = "xoxd_npm_gftb_site_lock", version = "1.0.0")
bazel_dep(name = "xoxd_npm_gftb_site_lint", version = "1.0.0")

# PLACEHOLDER COMMIT: the registry commit below is the one the tummycrypt
# overrides name today. PR-R2 adds xoxd_npm_gftb_site_{lock,lint} 1.0.0 to
# xoxd-ai/bazel-registry; all four overrides then move to the PR-R2 merge
# commit together, and `just module-lock` records it.
single_version_override(
    module_name = "xoxd_npm_gftb_site_lock",
    registry = "https://raw.githubusercontent.com/xoxd-ai/bazel-registry/e912ea7e26b19f412b2daf4c67d363bb2475ea8a",
)

single_version_override(
    module_name = "xoxd_npm_gftb_site_lint",
    registry = "https://raw.githubusercontent.com/xoxd-ai/bazel-registry/e912ea7e26b19f412b2daf4c67d363bb2475ea8a",
)

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "@xoxd_npm_gftb_site_lock//:pnpm-lock.yaml",
    # The lock module is not the root package, so the importer "." of its
    # lock is linked into this repository's root package.
    root_package = "",
    link_workspace = "@",
    # RU13: npm_translate_lock applies the pnpm `patchedDependencies` recorded
    # in pnpm-lock.yaml; the readPackage hook and every patch file must be
    # declared inputs (patches/README.md in the lock module).
    data = [
        "@xoxd_npm_gftb_site_lock//:.pnpmfile.cjs",
        "@xoxd_npm_gftb_site_lock//:package.json",
        "@xoxd_npm_gftb_site_lock//:patches/@sveltejs__kit@3.0.1.patch",
        "@xoxd_npm_gftb_site_lock//:patches/devalue@5.9.4.patch",
        "@xoxd_npm_gftb_site_lock//:patches/svelte-check@4.7.6.patch",
        "@xoxd_npm_gftb_site_lock//:pnpm-workspace.yaml",
    ],
    # Browser packages must never fetch browser binaries at npm lifecycle time
    # (GloriousFlywheel browser-rbe-candidate-guide, lifecycle download
    # policy): //:browser_smoke_test launches the pre-provisioned worker
    # Chromium named by GF_RBE_CHROMIUM_EXECUTABLE instead.
    lifecycle_hooks_envs = {
        "playwright": {"PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD": "1"},
    },
)

# The 160 npm_replace_package tags of the P1 module, a verbatim copy of
# @xoxd_npm_gftb_site_lint//:npm_payload.MODULE.bazel (a contract test
# compares the two). Every replaced package links from P1, so no npm
# sources repository exists for the lint closure.
include("//:npm_payload.MODULE.bazel")
use_repo(npm, "npm")

# Hermetic source validators for the v4 validate ActionPlan (TIN-4251), ported
# from the house Bazel pattern: rules_multitool pins Gitleaks and actionlint per
# platform in multitool.lock.json, and gitleaks_test.bzl binds each binary to a
# declared source capsule inside its cacheable test action.
multitool = use_extension("@rules_multitool//multitool:extension.bzl", "multitool")
multitool.hub(lockfile = "//:multitool.lock.json")
use_repo(multitool, "multitool")

register_toolchains("@multitool//toolchains:all")

# Browser e2e (R583, TIN-7477): a Chromium from the Nix store, chosen through
# toolchain resolution. The toolchain() targets live in //tools/chromium, so
# resolving any other toolchain never fetches @chromium_nix; only a target
# that resolves the Chromium toolchain (//:e2e_test) does.
chromium_nix = use_repo_rule("//tools/chromium:repo.bzl", "chromium_nix")

chromium_nix(
    name = "chromium_nix",
    paths = "//tools/chromium:nix-paths.json",
)

register_toolchains("//tools/chromium:all")

# The club's agreements, compiled in the private meta repository by its
# tectonic pipeline and published as releases in the public meta-public
# repository (operator ruling 2026-09-19). Pinned by URL and sha256; a new
# document version is a new release tag and a bump here. //:app_workspace
# copies them to static/agreements/ for the /legal route.
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "member_agreement_v1_pdf",
    downloaded_file_path = "member-agreement-v1.pdf",
    sha256 = "cbf6e8a1fd5025252b9ff4fba0ebccd37165ca7f6eaa415b1cbb297da9cb9882",
    urls = ["https://github.com/Great-Falls-Tool-Bus/meta-public/releases/download/member-agreement/v1.0.0/member-agreement-v1.pdf"],
)

http_file(
    name = "code_of_conduct_pdf",
    downloaded_file_path = "code-of-conduct.pdf",
    sha256 = "fc84ff8c322ac3d2bd03de737ef8a68c238d52ba9de26c83ebcd7511b03c5069",
    urls = ["https://github.com/Great-Falls-Tool-Bus/meta-public/releases/download/code-of-conduct/v1.0.0/code-of-conduct.pdf"],
)
