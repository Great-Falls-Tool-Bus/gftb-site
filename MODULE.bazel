"""
site.scaffold - Bazel Module Configuration

Static-first SvelteKit consumer of the @tummycrypt/* packages produced by
tinyland-inc/bazel-registry. TIN-2838: those four in-house packages are ingested
Bazel-only — graph-linked via `npm_link_package` from each module's `pkg` target
(see BUILD.bazel `TINYLAND_HOUSE_PACKAGES`), NOT resolved as npm specifiers.
package.json carries none of them. `just build` invokes `bazel build //:build`
and transactionally materializes that target's declared output, so plugins and
runtime imports resolve directly from the Bazel graph. This canonical entrypoint
does not imply routine executor-backed RBE; TIN-2851 remains blocked and the repo
stays shared-cache-backed.

Stock module picks (replace per-site as needed):

- tummycrypt_tinyland_color_utils — runtime color leaf (zero deps).
- tummycrypt_vite_plugin_a11y      — build-time WCAG scan plugin.
- tummycrypt_vite_plugin_skeleton_colors — Skeleton-4 color generator.
- tummycrypt_tinyvectors            — animated vector blob backgrounds.

After cloning from this template:
  1. Update `module(name = ...)` to your_site_underscored.
  2. Run `scripts/rebrand.sh <site.example.com>` to sed brand strings.
  3. `bazelisk mod graph` should succeed before first commit.
"""

module(
    name = "site_scaffold",
    version = "0.0.1",
    compatibility_level = 1,
)

# Core
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "rules_pkg", version = "1.1.0")

# JS/TS toolchain (Aspect)
bazel_dep(name = "rules_nodejs", version = "6.7.3")
bazel_dep(name = "aspect_rules_js", version = "2.9.1")
bazel_dep(name = "aspect_rules_ts", version = "3.8.4")
bazel_dep(name = "aspect_rules_swc", version = "2.6.1")

# Tinyland building-block deps via tinyland-inc/bazel-registry. package.json
# intentionally carries no first-party specifiers; `just inhouse-package-parity`
# verifies each module is graph-linked through its Bazel `pkg` target.
bazel_dep(name = "tummycrypt_tinyland_color_utils", version = "0.2.3")
bazel_dep(name = "tummycrypt_vite_plugin_a11y", version = "0.2.4")
bazel_dep(name = "tummycrypt_vite_plugin_skeleton_colors", version = "0.2.4")
# TIN-2838: 0.3.4 (mothership tinyland.dev's proven pin), not 0.3.0. The 0.3.0
# `pkg`/`:tinyvectors_declarations` producer target runs `tsc -p
# tsconfig.declarations.json` with a relative path that does not resolve from the
# external-repo action cwd under the Bazel sandbox (TS5058), so graph-linking the
# 0.3.0 `pkg` cannot build. 0.3.4 is the fixed, already-published version — a pin
# selection, not an in-place edit of a shipped module.
bazel_dep(name = "tummycrypt_tinyvectors", version = "0.3.4")

# Node 22.13.1
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "22.13.1")

# pnpm 10.13.1
pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(
    name = "pnpm",
    pnpm_version = "10.13.1",
)
use_repo(pnpm, "pnpm")

# npm via pnpm-lock.yaml. Repo name "npm" matches the elders / Aspect
# convention. Per the audit, no @npm collision risk against the
# selected modules — they all use per-module <module>_npm naming.
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    npmrc = "//:.npmrc",
    pnpm_lock = "//:pnpm-lock.yaml",
    data = [
        "//:package.json",
        "//:pnpm-workspace.yaml",
    ],
)
use_repo(npm, "npm")

# TypeScript 6.0.3 — must match package.json exactly (rules_ts cannot parse
# caret ranges, and house-stack-contract.test.ts fails on any drift between
# the two files). 6.0.3 postdates rules_ts 3.8.4's built-in version map, so
# the npm dist integrity is pinned explicitly.
rules_ts_ext = use_extension("@aspect_rules_ts//ts:extensions.bzl", "ext")
rules_ts_ext.deps(
    ts_version = "6.0.3",
    ts_integrity = "sha512-y2TvuxSZPDyQakkFRPZHKFm+KKVqIisdg9/CZwm9ftvKXLP8NRWj38/ODjNbr43SsoXqNuAisEf1GdCxqWcdBw==",
)
use_repo(rules_ts_ext, "npm_typescript")

# SWC for any future ts_project targets
swc = use_extension("@aspect_rules_swc//swc:extensions.bzl", "swc")
swc.toolchain(
    name = "swc",
    swc_version = "v1.10.12",
)
use_repo(swc, "swc_toolchains")

register_toolchains("@swc_toolchains//:all")
