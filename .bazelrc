# greatfallstoolbus.org Bazel Configuration
#
# Bazel 8 + Bzlmod. Mirrors elders.tinyland.dev's two-registry chain:
# tinyland-inc/bazel-registry first, then BCR. Canonical Just recipes and CI
# resolve finite actions through the v4 client. This file contains no cache,
# executor, provider, local-profile, or fallback policy.

common --enable_bzlmod
# Supply-chain hardening (mirrors MassageIthaca): pin tinyland-inc/bazel-registry
# to an immutable commit SHA instead of the mutable `main` ref so module metadata
# (MODULE.bazel + source.json) cannot silently change under us. Bump the SHA
# deliberately and refresh MODULE.bazel.lock when the registry advances:
#   sed -i '' "s|bazel-registry/[0-9a-f]\{40\}|bazel-registry/$(gh api repos/tinyland-inc/bazel-registry/commits/main --jq .sha)|" .bazelrc
# bcr stays as a secondary registry; the Tinyland registry stays first so
# in-house Bazel modules resolve before falling through to bcr.bazel.build.
common --registry=https://raw.githubusercontent.com/tinyland-inc/bazel-registry/ef734c4a26045a7b396913e6cf410e50fbe16635
common --registry=https://bcr.bazel.build

# The source-marker rule projects native BUILD_EMBED_LABEL; larger actions
# consume only that deterministic file. The GF client supplies --embed_label
# from the accepted action's exact source SHA.

# Build performance
build --jobs=auto
build --worker_sandboxing
build --keep_going
build --show_timestamps

# rules_ts: skip lib check is required for SvelteKit-style declaration files.
build --@aspect_rules_ts//ts:skipLibCheck=always

# Test output
test --test_output=errors
test --test_summary=detailed
test --test_verbose_timeout_warnings
test --test_timeout=120,600,1800,3600
