# greatfallstoolbus.org Bazel Configuration
#
# Bazel 9.2 + Bzlmod. Canonical Just recipes execute finite Bazel targets. CI
# resolves those targets through the v4 action fabric; this file contains no
# cache, executor, provider, or fallback policy.
#
# No registry is named here (R574, TIN-7477). MODULE.bazel binds the two
# first-party modules to their immutable xoxd-ai/bazel-registry commit, and
# every other module comes from Bazel's default registry, bcr.bazel.build.
# A local run and the fabric's --ignore_all_rc_files run therefore resolve
# the same graph against the same MODULE.bazel.lock.

common --enable_bzlmod

# BASE_PATH and commit identity are stable Bazel inputs to stamped terminal
# build actions, not undeclared ambient action environment.
build --workspace_status_command=scripts/bazel/workspace-status.sh

# Build performance
build --jobs=auto
build --worker_sandboxing
build --keep_going
build --show_timestamps

# rules_ts: skip lib check is required for SvelteKit-style declaration files.
build --@aspect_rules_ts//ts:skipLibCheck=always
build --spawn_strategy=sandboxed,worker,local

# Test output
test --test_output=errors
test --test_summary=detailed
test --test_verbose_timeout_warnings
test --test_timeout=120,600,1800,3600

try-import %workspace%/user.bazelrc
