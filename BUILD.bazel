# The v4 validation action carries its own exact source capsule, so secret
# scanning becomes a hermetic Bazel test inside the same REAPI action rather
# than a second runner job. Ported from greatfallstoolbus.org
# (gitleaks_test.bzl + multitool.lock.json), adapted to this repo's tree.
filegroup(
    name = "current_source_secret_scan_srcs",
    srcs = [
        "//tools/site-draft-compiler:source_inputs",
        ".bazelignore",
        ".bazelrc",
        ".bazelversion",
        ".editorconfig",
        ".envrc",
        ".gitignore",
        ".gitleaks.toml",
        ".gitleaksignore",
        ".nvmrc",
        ".prettierignore",
        ".prettierrc",
        "BUILD.bazel",
        "CHANGELOG.md",
        "CONTRIBUTING.md",
        "Justfile",
        "LICENSE",
        "LICENSE-content",
        "MODULE.bazel",
        "MODULE.bazel.lock",
        "NOTICE",
        "README.md",
        "SECURITY.md",
        "eslint.config.ts",
        "flake.lock",
        "flake.nix",
        "gitleaks_test.bzl",
        "multitool.lock.json",
        "npm_payload.MODULE.bazel",
        "package.json",
        "kit.config.js",
        "tinyland.repo.json",
        "tsconfig.json",
        "vite.config.ts",
        "vitest.config.ts",
    ] + glob(
        [
            ".githooks/**",
            ".github/**",
            "docs/**",
            "e2e/**",
            "scripts/**",
            "src/**",
            "static/**",
            "tools/bazel/**",
            "tools/chromium/**",
            "tools/ts/**",
        ],
        allow_empty = True,
        exclude = [
            "**/.DS_Store",
            "**/__pycache__/**",
            "static/agreements/**",
        ],
    ),
)

# The v4 validate action carries the secret scan inside the same finite Bazel
# action graph. It uses a hermetic, platform-pinned gitleaks binary and needs no
# second runner job or repository-local lifecycle wrapper.
copy_to_directory(
    name = "current_source_secret_scan_tree",
    srcs = [":current_source_secret_scan_srcs"],
    hardlink = "off",
    root_paths = ["."],
)

gitleaks_test(
    name = "current_source_secret_scan_test",
    timeout = "short",
    source_tree = ":current_source_secret_scan_tree",
    config = ".gitleaks.toml",
)

# Workflow syntax is part of the protected v4 source contract. Keep actionlint
# inside the finite test graph with a checksummed multitool binary instead of
# depending on a runner-installed executable.
filegroup(
    name = "workflow_validation_srcs",
    srcs = glob(
        [".github/workflows/*.yml"],
        allow_empty = False,
    ),
)

actionlint_test(
    name = "workflow_validation_test",
    config = ".github/actionlint.yaml",
    srcs = [":workflow_validation_srcs"],
    timeout = "short",
)

js_binary(
    name = "sveltekit_sync_bin",
    data = APP_NPM_PACKAGES,
    entry_point = "scripts/bazel/run-sveltekit-sync.mjs",
)

# SvelteKit 3 sync writes the route types under .svelte-kit and the parent
# tsconfig plus `$app/types` under node_modules/$app (tsconfig.json extends
# "$app/tsconfig"). Both trees are declared outputs so every consumer sees the
# same generated types.
js_run_binary(
    name = "sveltekit_types",
    srcs = [":app_srcs"],
    out_dirs = [
        ".svelte-kit",
        "node_modules/$app",
    ],
    tool = ":sveltekit_sync_bin",
)

# The two agreement PDFs fetched by MODULE.bazel's http_file pins land at
# static/agreements/ inside the workspace the vite build reads, so the /legal
# route serves them like any static file (the route's own output directory
# stays free). Nothing under static/agreements/ is a source: both static globs
# above exclude it and .bazelignore names it.
copy_file(
    name = "legal_member_agreement_v1",
    src = "@member_agreement_v1_pdf//file",
    out = "static/agreements/member-agreement-v1.pdf",
)

copy_file(
    name = "legal_code_of_conduct",
    src = "@code_of_conduct_pdf//file",
    out = "static/agreements/code-of-conduct.pdf",
)

copy_to_directory(
    name = "app_workspace",
    srcs = [
        ":app_srcs",
        ":sveltekit_types",
        ":legal_member_agreement_v1",
        ":legal_code_of_conduct",
        # The supply-chain seams src/lib/brand-vectors-motion-contract.test.ts
        # and src/lib/house-stack-contract.test.ts read from the workspace
        # root: the bazel_dep pin, the immutable registry binding in
        # MODULE.bazel, the rc file that must name no registry, and the lock
        # entry that binds them together.
        ".bazelrc",
        "MODULE.bazel",
        "MODULE.bazel.lock",
        # src/lib/house-stack-contract.test.ts reads the P1 replacement tags
        # and three P0 lock-module files (R577), which land at the workspace
        # root as before: an external file keeps its path inside its module.
        "npm_payload.MODULE.bazel",
        "@xoxd_npm_gftb_site_lock//:.pnpmfile.cjs",
        "@xoxd_npm_gftb_site_lock//:pnpm-lock.yaml",
        "@xoxd_npm_gftb_site_lock//:pnpm-workspace.yaml",
    ],
    hardlink = "off",
    include_external_repositories = ["xoxd_npm_gftb_site_lock+"],
    root_paths = ["."],
)

js_binary(
    name = "svelte_check_bin",
    data = TYPECHECK_NPM_PACKAGES + ["scripts/bazel/prepare-sveltekit-types.mjs"],
    entry_point = "scripts/bazel/run-svelte-check.mjs",
    tags = ["manual", "no-remote-exec"],
)

# RU13: svelte-check runs in its TypeScript 7 native mode (`--tsgo`), so
# TypeScript 7.0.2 checks every .svelte and .ts file the tsconfig includes.
# --tsgo writes transpiled components into .svelte-kit, which is read-only in
# runfiles, so the runner checks a writable scratch copy of :app_workspace.
js_test(
    name = "svelte_check_test",
    args = [
        "--workspace",
        "$(rootpath :app_workspace)",
    ],
    data = [
        ":app_workspace",
        "scripts/bazel/prepare-sveltekit-types.mjs",
    ] + TYPECHECK_NPM_PACKAGES,
    entry_point = "scripts/bazel/run-svelte-check.mjs",
    timeout = "long",
)

# Seeded-error canary for the gate above: a .ts and a .svelte type error are
# written into the scratch copy and the test fails unless svelte-check --tsgo
# reports both. Under --tsgo a tsconfig that checks nothing reports 0 errors
# (sveltejs/language-tools#3136); this keeps a false green visible.
js_test(
    name = "svelte_check_canary_test",
    args = [
        "--workspace",
        "$(rootpath :app_workspace)",
        "--canary",
    ],
    data = [
        ":app_workspace",
        "scripts/bazel/prepare-sveltekit-types.mjs",
    ] + TYPECHECK_NPM_PACKAGES,
    entry_point = "scripts/bazel/run-svelte-check.mjs",
    timeout = "long",
)

# ESLint reads sources only. No configured rule is type-aware (there is no
# parserOptions.project), and eslint.config.ts ignores .svelte-kit/ and
# node_modules/, so the generated //:sveltekit_types trees were never linted.
# Leaving them out keeps the multi-GB SvelteKit and TinyVectors build inputs
# out of this test's closure (TIN-7477). Type checking stays in
# //:svelte_check_test and //:svelte_check_canary_test.
# R575 (TIN-7477, C1): no hub package_json.bzl is loaded anywhere. A bin
# macro loads the npm sources repository of its package, and that repository
# always downloads the npm tarball, which the GFTB cell refuses. These are
# plain rules_js targets whose entry point is a path inside the linked
# package directory, so every lint input comes from the P1 payload module.
# Each path is the package.json `bin` entry that P1's MANIFEST.json records;
# //:bazel_output_contract_test compares them.
directory_path(
    name = "eslint_entry",
    directory = ":node_modules/eslint/dir",
    path = "./bin/eslint.js",
)

js_test(
    name = "eslint_test",
    args = ["."],
    data = [":app_srcs", ":e2e_srcs", "//tools/site-draft-compiler:format_inputs", "eslint.config.ts"] + LINT_NPM_PACKAGES,
    entry_point = ":eslint_entry",
    timeout = "moderate",
    # Lint and formatting: `just check` runs it, `just gate-deploy` does not (TIN-7477).
    tags = ["lint"],
)

directory_path(
    name = "prettier_entry",
    directory = ":node_modules/prettier/dir",
    path = "./bin/prettier.cjs",
)

js_test(
    name = "prettier_check_test",
    args = ["--check", "."],
    data = [":format_srcs", ":node_modules/prettier", ":node_modules/prettier-plugin-svelte", ":node_modules/svelte"],
    entry_point = ":prettier_entry",
    timeout = "short",
    # Lint and formatting: `just check` runs it, `just gate-deploy` does not (TIN-7477).
    tags = ["lint"],
)

# `just format` (R577): prettier --write over the checkout itself. js_binary's
# chdir is a fixed output-tree path and expands no variables, so
# tools/bazel/in_workspace.mjs names BUILD_WORKSPACE_DIRECTORY instead: the
# ignore files and every path argument become absolute checkout paths, while
# Prettier keeps resolving its .prettierrc plugin from the runfiles. The
# prettier path is the same MANIFEST `bin` entry as :prettier_entry.
js_binary(
    name = "prettier_write",
    args = [
        "--paths-from-workspace",
        "prettier/bin/prettier.cjs",
        "--ignore-path",
        "WORKSPACE:.gitignore",
        "--ignore-path",
        "WORKSPACE:.prettierignore",
        "--write",
    ],
    data = [
        ":node_modules/prettier",
        ":node_modules/prettier-plugin-svelte",
        ":node_modules/svelte",
    ],
    entry_point = "//tools/bazel:in_workspace",
    patch_node_fs = False,
    tags = ["manual"],
)

js_binary(
    name = "vite_build_bin",
    # build-metadata.mjs: the stable-status reader shared with the leak scan.
    # prepare-sveltekit-types.mjs: the shared scratch-workspace helpers.
    data = APP_NPM_PACKAGES + [
        "scripts/bazel/build-metadata.mjs",
        "scripts/bazel/prepare-sveltekit-types.mjs",
    ],
    entry_point = "scripts/bazel/run-vite-build.mjs",
)

js_run_binary(
    name = "build",
    args = ["--workspace", "$(rootpath :app_workspace)", "--output-dir", "build"],
    # The list-signup capture modal ships in the published candidate. The
    # flag is a committed build input, not an ambient variable, so the
    # scanned artifact is reproducible and the off-build proof in
    # e2e/subscribe-capture.spec.ts keeps running against a plain vite build.
    env = {"PUBLIC_SUBSCRIBE_CAPTURE": "1"},
    srcs = [":app_workspace"],
    out_dirs = ["build"],
    patch_node_fs = False,
    stamp = 1,
    tags = ["sveltekit-app-build"],
    tool = ":vite_build_bin",
    visibility = ["//visibility:public"],
)

# Publication is allowed to consume only this copied-and-scanned TreeArtifact.
# The copy and leak scan happen in one Bazel action: a scan failure produces no
# output, so //:deployment_bundle cannot package an unscanned //:build tree.
js_binary(
    name = "leak_scan_build_bin",
    data = [":app_srcs"],
    entry_point = "scripts/check-build-output.mjs",
)

js_run_binary(
    name = "scanned_build",
    args = [
        "$(rootpath :build)",
        "--copy-to",
        "scanned-build",
    ],
    out_dirs = ["scanned-build"],
    patch_node_fs = False,
    srcs = [":build"],
    # Stamped only to read STABLE_BUILD_TAILNET_PROBE_URL, the one tailnet
    # host the stamped //:build may carry; the scan allows exactly that host.
    stamp = 1,
    tool = ":leak_scan_build_bin",
    visibility = ["//visibility:public"],
)

js_run_binary(
    name = "analyze",
    args = [
        "--workspace",
        "$(rootpath :app_workspace)",
        "--output-dir",
        "build-analyze",
        "--analyze",
        "--analyze-output",
        ".bundle-stats/stats.html",
    ],
    srcs = [":app_workspace"],
    out_dirs = ["build-analyze", ".bundle-stats"],
    patch_node_fs = False,
    stamp = 1,
    tool = ":vite_build_bin",
    visibility = ["//visibility:public"],
)

js_binary(
    name = "dev",
    data = APP_NPM_PACKAGES,
    entry_point = "scripts/bazel/run-vite-dev.mjs",
    tags = ["manual", "no-remote-exec"],
    visibility = ["//visibility:public"],
