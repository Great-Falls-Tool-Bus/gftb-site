filegroup(
    name = "app_srcs",
    srcs = glob(
        [
            "src/**",
            "static/**",
            "scripts/bazel/**/*.mjs",
            # Acceptance-test-only modules the unit suite imports (leak scanner
            # and WCAG colour maths). They live outside src/lib so
            # shipped code cannot reach them, but //:unit_tests must.
            "scripts/lib/**/*.mjs",
            "scripts/lib/**/*.test.mts",
            "scripts/lib/**/*.json",
        ],
        allow_empty = True,
        # The two agreement PDFs are generated by the copy_file rules below;
        # Bazel's glob does not read .gitignore, so a checkout holding the
        # downloaded copies must not declare them as sources too.
        exclude = ["static/agreements/**"],
    ) + [
        "package.json",
        # src/lib/leak-scan.test.ts asserts this stays a THIN runner over
        # scripts/lib/leak-scan.mjs, so the workspace has to carry it.
        "scripts/check-build-output.mjs",
        # The served-tinyvectors proof and its unit test, collected by
        # //:unit_tests (vitest includes scripts/**/*.test.mts).
        "scripts/check-served-tinyvectors.mjs",
        "scripts/check-served-tinyvectors.test.mts",
        # scripts/lib/tailnet-probe-stamp.test.mts executes the status command
        # to prove a malformed probe URL is neither echoed nor fatal.
        "scripts/bazel/workspace-status.sh",
        "kit.config.js",
        "tsconfig.json",
        "vite.config.ts",
        "vitest.config.ts",
    ],
)

