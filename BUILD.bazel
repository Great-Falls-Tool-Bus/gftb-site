"""Finite Bazel graph for the Great Falls Tool Bus static microsite."""

load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_run_binary", "js_test")
load("@aspect_rules_js//npm:defs.bzl", "npm_link_package")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//:eslint/package_json.bzl", eslint_bin = "bin")
load("@npm//:prettier/package_json.bzl", prettier_bin = "bin")
load("@rules_python//python:defs.bzl", "py_test")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//:gitleaks_test.bzl", "gitleaks_test")

npm_link_all_packages(name = "node_modules")

# Bazel is the only carrier for this first-party Vite plugin.
npm_link_package(
    name = "node_modules/@tummycrypt/vite-plugin-a11y",
    src = "@tummycrypt_vite_plugin_a11y//:pkg",
)

# Bazel is likewise the only carrier for the TinyVectors brand background
# (Bazel-only ingestion; scripts/check-inhouse-package-parity.py enforces
# the bazel_dep + npm_link_package pairing and the absence of any npm
# specifier).
npm_link_package(
    name = "node_modules/@tummycrypt/tinyvectors",
    src = "@tummycrypt_tinyvectors//:pkg",
)

APP_NPM_PACKAGES = [
    ":node_modules/@fontsource-variable/fira-code",
    ":node_modules/@fontsource-variable/fraunces",
    ":node_modules/@fontsource/crimson-pro",
    ":node_modules/@fontsource/inter",
    ":node_modules/@skeletonlabs/skeleton",
    ":node_modules/@skeletonlabs/skeleton-svelte",
    ":node_modules/@sveltejs/adapter-static",
    ":node_modules/@sveltejs/kit",
    ":node_modules/@sveltejs/vite-plugin-svelte",
    ":node_modules/@tailwindcss/vite",
    ":node_modules/@types/node",
    ":node_modules/mdsvex",
    ":node_modules/rollup-plugin-visualizer",
    ":node_modules/shiki",
    ":node_modules/svelte",
    ":node_modules/tailwindcss",
    ":node_modules/typescript",
    ":node_modules/vite",
    ":node_modules/@tummycrypt/tinyvectors",
    ":node_modules/@tummycrypt/vite-plugin-a11y",
]

LINT_NPM_PACKAGES = [
    ":node_modules/@eslint/js",
    ":node_modules/eslint",
    ":node_modules/eslint-config-prettier",
    ":node_modules/eslint-plugin-svelte",
    ":node_modules/globals",
    ":node_modules/prettier",
    ":node_modules/prettier-plugin-svelte",
    ":node_modules/svelte",
    ":node_modules/typescript",
    ":node_modules/typescript-eslint",
]

TYPECHECK_NPM_PACKAGES = APP_NPM_PACKAGES + [
    ":node_modules/svelte-check",
    ":node_modules/vitest",
]

UNIT_TEST_NPM_PACKAGES = APP_NPM_PACKAGES + [
    ":node_modules/@vitest/coverage-v8",
    ":node_modules/vitest",
]

filegroup(
    name = "app_srcs",
    srcs = glob(
        [
            "src/**",
            "static/**",
            "scripts/bazel/**/*.mjs",
            # Acceptance-test-only modules the unit suite imports (leak scanner
            # and WCAG colour maths). They live outside src/lib so
            # shipped code cannot reach them, but //:unit_tests must.
            "scripts/lib/**/*.mjs",
            "scripts/lib/**/*.test.mts",
            "scripts/lib/**/*.json",
        ],
        allow_empty = True,
    ) + [
        ".npmrc",
        "package.json",
        "playwright.config.ts",
        # src/lib/leak-scan.test.ts asserts this stays a THIN runner over
        # scripts/lib/leak-scan.mjs, so the workspace has to carry it.
        "scripts/check-build-output.mjs",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "svelte.config.js",
        "tsconfig.json",
        "vite.config.ts",
        "vitest.config.ts",
    ],
)

filegroup(
    name = "format_srcs",
    srcs = glob(
        [
            ".agents/**/*.yaml",
            ".github/**/*.json",
            ".github/**/*.yaml",
            ".github/**/*.yml",
            "docs/**/*.json",
            "e2e/**/*.mjs",
            "e2e/**/*.ts",
            "scripts/**/*.js",
            "scripts/**/*.json",
            "scripts/**/*.mjs",
            "scripts/**/*.mts",
            "src/**/*.css",
            "src/**/*.html",
            "src/**/*.js",
            "src/**/*.json",
            "src/**/*.svelte",
            "src/**/*.svx",
            "src/**/*.ts",
        ],
        allow_empty = True,
    ) + [
        ".prettierignore",
        ".prettierrc",
        "eslint.config.ts",
        "package.json",
        "playwright.config.ts",
        "pnpm-workspace.yaml",
        "svelte.config.js",
        "tinyland.repo.json",
        "tsconfig.json",
        "vite.config.ts",
        "vitest.config.ts",
    ],
)

filegroup(
    name = "e2e_srcs",
    srcs = glob(["e2e/**"], allow_empty = True),
)

# The v4 validation action carries its own exact source capsule, so secret
# scanning becomes a hermetic Bazel test inside the same REAPI action rather
# than a second runner job. Ported from greatfallstoolbus.org
# (gitleaks_test.bzl + multitool.lock.json), adapted to this repo's tree.
filegroup(
    name = "current_source_secret_scan_srcs",
    srcs = [
        ".bazelignore",
        ".bazelrc",
        ".bazelrc.flywheel",
        ".bazelversion",
        ".editorconfig",
        ".envrc",
        ".gitignore",
        ".gitleaks.toml",
        ".gitleaksignore",
        ".npmrc",
        ".nvmrc",
        ".prettierignore",
        ".prettierrc",
        "AGENTS.md",
        "BUILD.bazel",
        "CLAUDE.md",
        "Justfile",
        "LICENSE",
        "LICENSE-content",
        "MODULE.bazel",
        "MODULE.bazel.lock",
        "NOTICE",
        "README.md",
        "SECURITY.md",
        "eslint.config.ts",
        "flake.lock",
        "flake.nix",
        "gitleaks_test.bzl",
        "multitool.lock.json",
        "package.json",
        "playwright.config.ts",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "svelte.config.js",
        "tinyland.repo.json",
        "tsconfig.json",
        "vite.config.ts",
        "vitest.config.ts",
    ] + glob(
        [
            ".agents/**",
            ".github/**",
            "docs/**",
            "e2e/**",
            "scripts/**",
            "src/**",
            "static/**",
        ],
        allow_empty = True,
        exclude = [
            "**/.DS_Store",
            "**/__pycache__/**",
        ],
    ),
)

# INERT today (TIN-4251 v4 prep): tagged `manual` and deliberately in NO test
# suite — gf-action-client is not in the runner image yet, so nothing can
# execute this target in current CI. Promote it into the validate ActionPlan
# when the v4 fabric executes (TIN-4251); the runner-side `ci / secrets-scan`
# job remains authoritative until then.
gitleaks_test(
    name = "current_source_secret_scan_test",
    timeout = "short",
    srcs = [":current_source_secret_scan_srcs"],
    config = ".gitleaks.toml",
    tags = ["manual"],
)

js_binary(
    name = "sveltekit_sync_bin",
    data = APP_NPM_PACKAGES,
    entry_point = "scripts/bazel/run-sveltekit-sync.mjs",
)

js_run_binary(
    name = "sveltekit_types",
    srcs = [":app_srcs"],
    out_dirs = [".svelte-kit"],
    tool = ":sveltekit_sync_bin",
)

copy_to_directory(
    name = "app_workspace",
    srcs = [
        ":app_srcs",
        ":sveltekit_types",
        "MODULE.bazel",
    ],
    hardlink = "off",
    root_paths = ["."],
)

js_binary(
    name = "svelte_check_bin",
    data = TYPECHECK_NPM_PACKAGES,
    entry_point = "scripts/bazel/run-svelte-check.mjs",
    tags = ["manual", "no-remote-exec"],
)

js_test(
    name = "svelte_check_test",
    data = [":app_srcs", ":sveltekit_types"] + TYPECHECK_NPM_PACKAGES,
    entry_point = "scripts/bazel/run-svelte-check.mjs",
    timeout = "long",
)

eslint_bin.eslint_test(
    name = "eslint_test",
    args = ["."],
    data = [":app_srcs", ":e2e_srcs", ":sveltekit_types", "eslint.config.ts"] + LINT_NPM_PACKAGES,
    timeout = "moderate",
)

prettier_bin.prettier_test(
    name = "prettier_check_test",
    args = ["--check", "."],
    data = [":format_srcs", ":node_modules/prettier", ":node_modules/prettier-plugin-svelte", ":node_modules/svelte"],
    timeout = "short",
)

js_binary(
    name = "vite_build_bin",
    data = APP_NPM_PACKAGES,
    entry_point = "scripts/bazel/run-vite-build.mjs",
)

js_run_binary(
    name = "build",
    args = ["--workspace", "$(rootpath :app_workspace)", "--output-dir", "build"],
    srcs = [":app_workspace"],
    out_dirs = ["build"],
    patch_node_fs = False,
    stamp = 1,
    tags = ["flywheel-eligible", "sveltekit-app-build"],
    tool = ":vite_build_bin",
    visibility = ["//visibility:public"],
)

js_run_binary(
    name = "analyze",
    args = [
        "--workspace",
        "$(rootpath :app_workspace)",
        "--output-dir",
        "build-analyze",
        "--analyze",
        "--analyze-output",
        ".bundle-stats/stats.html",
    ],
    srcs = [":app_workspace"],
    out_dirs = ["build-analyze", ".bundle-stats"],
    patch_node_fs = False,
    stamp = 1,
    tool = ":vite_build_bin",
    visibility = ["//visibility:public"],
)

js_binary(
    name = "dev",
    data = APP_NPM_PACKAGES,
    entry_point = "scripts/bazel/run-vite-dev.mjs",
    tags = ["manual", "no-remote-exec"],
    visibility = ["//visibility:public"],
)

js_test(
    name = "unit_tests",
    data = [":app_workspace", "scripts/bazel/prepare-sveltekit-types.mjs"] + UNIT_TEST_NPM_PACKAGES,
    args = ["--workspace", "$(rootpath :app_workspace)", "run", "--reporter=verbose", "--config", "vitest.config.ts"],
    entry_point = "scripts/bazel/run-vitest.mjs",
    tags = ["flywheel-eligible", "sveltekit-unit-tests", "vitest"],
    visibility = ["//visibility:public"],
)

js_binary(
    name = "vitest_coverage_bin",
    data = ["scripts/bazel/prepare-sveltekit-types.mjs"] + UNIT_TEST_NPM_PACKAGES,
    entry_point = "scripts/bazel/run-vitest.mjs",
)

js_run_binary(
    name = "unit_test_coverage",
    args = [
        "--workspace",
        "$(rootpath :app_workspace)",
        "--coverage-output",
        "coverage",
        "run",
        "--reporter=verbose",
        "--config",
        "vitest.config.ts",
    ],
    out_dirs = ["coverage"],
    srcs = [":app_workspace"],
    tags = ["manual", "no-remote-exec"],
    tool = ":vitest_coverage_bin",
)

py_test(
    name = "bazel_output_contract_test",
    srcs = [
        "scripts/bazel_output.py",
        "scripts/test-bazel-cutover-contracts.py",
    ],
    main = "scripts/test-bazel-cutover-contracts.py",
    imports = ["scripts"],
    data = [
        ":app_srcs",
        ".github/workflows/ci.yml",
        ".github/workflows/container-ghcr.yml",
        "BUILD.bazel",
        "Justfile",
        "MODULE.bazel",
        "flake.nix",
    ],
    tags = ["flywheel-eligible"],
)

# Chromium loopback smoke over the declared //:build output, per
# GloriousFlywheel's browser-RBE candidate template (examples/web-rbe/*) and
# public-docs/browser-rbe-candidate-guide.md: build through declared Bazel
# inputs, serve that output from inside the test action on 127.0.0.1, launch
# the pre-provisioned worker Chromium named by GF_RBE_CHROMIUM_EXECUTABLE via
# playwright's explicit executablePath, with writable HOME/XDG dirs under test
# scratch and no action-time browser download (MODULE.bazel pins
# PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD at npm lifecycle time).
#
# INERT today (TIN-4251 v4 prep): `manual` keeps every suite, wildcard, and
# current CI lane from selecting it — gf-action-client is not in the runner
# image (G1) and the org tenant overlay is not admitted (G2). Promotion path:
# a third lanes.json action `e2e` selecting this target once the tenant
# binding lands.
#
# GF_BROWSER_SMOKE_REQUIRE_PROVENANCE=1: //:build is stamped (stamp = 1) and
# the footer provenance line renders only when the stamp carries a real commit
# identity (BUILD_COMMIT_SHA / GITHUB_SHA — CI and fabric invocations); an
# identity-less local run fails that leg by design (the footer's own
# degrade-to-nothing contract), or relax it with
# --test_env=GF_BROWSER_SMOKE_REQUIRE_PROVENANCE=0.
js_test(
    name = "browser_smoke_test",
    data = [
        ":build",
        ":e2e_srcs",
        ":node_modules/@playwright/test",
    ],
    entry_point = "e2e/bazel/run-browser-smoke.mjs",
    env = {
        "GF_BROWSER_SMOKE_BUILD_DIR": "$(rootpath :build)",
        "GF_BROWSER_SMOKE_PATH": "/",
        "GF_BROWSER_SMOKE_TITLE": "Great Falls Tool Bus",
        "GF_BROWSER_SMOKE_REQUIRE_PROVENANCE": "1",
    },
    tags = [
        "browser-smoke",
        "manual",
    ],
    timeout = "moderate",
)

test_suite(
    name = "ci_validation_suite",
    tests = [":bazel_output_contract_test", ":svelte_check_test", ":unit_tests"],
)

test_suite(
    name = "lint_suite",
    tests = [":eslint_test", ":prettier_check_test"],
)

test_suite(
    name = "local_validation_suite",
    tests = [
        ":bazel_output_contract_test",
        ":eslint_test",
        ":prettier_check_test",
        ":svelte_check_test",
        ":unit_tests",
    ],
)

pkg_tar(
    name = "deployment_bundle",
    srcs = [":build"],
    extension = "tar.gz",
    tags = ["deployment-bundle-packaging", "flywheel-eligible"],
    visibility = ["//visibility:public"],
)

# The publisher consumes this cacheable context, but image assembly and registry
# mutation stay local to the trusted GitHub runner and never use remote exec.
pkg_tar(
    name = "container_image_context",
    srcs = [":deployment_bundle", "flake.lock", "flake.nix", "package.json", "pnpm-lock.yaml", "svelte.config.js"],
    extension = "tar",
    tags = ["container-image-and-push", "gloriousflywheel-cache-only", "no-remote-exec"],
    visibility = ["//visibility:public"],
)

exports_files(
    [
        "MODULE.bazel",
        "package.json",
        "playwright.config.ts",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "scripts/bazel/prepare-sveltekit-types.mjs",
        "scripts/bazel/run-svelte-check.mjs",
        "scripts/bazel/run-sveltekit-sync.mjs",
        "scripts/bazel/run-vitest.mjs",
        "scripts/bazel/run-vite-build.mjs",
        "scripts/bazel/run-vite-dev.mjs",
        "scripts/bazel/workspace-status.sh",
        "svelte.config.js",
        "tsconfig.json",
        "vite.config.ts",
        "vitest.config.ts",
    ],
    visibility = ["//visibility:public"],
)
