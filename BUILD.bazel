# Finite Chromium acceptance over the declared //:build output. GF's
# docs/build-system/browser-runtime-authority.md (TIN-1131) owns the
# provisioned runtime: explicit executablePath, private test scratch, and no
# browser downloads. The consumer names its canonical interface, never a
# provider image or runner. A missing runtime fails this registered gate.
# This target tests nine exact specs over its own ephemeral loopback server;
# it neither builds a second site nor proves a deployed environment or LOOK.
js_test(
    name = "browser_smoke_test",
    data = [
        ":app_srcs",
        ":build",
        ":e2e_srcs",
        ":node_modules/@playwright/test",
    ],
    args = [
        "--config",
        "browser-acceptance.config.ts",
        "--chromium-env",
        "GF_RBE_CHROMIUM_EXECUTABLE",
        "--label",
        "nine acceptance specs",
    ],
    entry_point = "e2e/bazel/run-browser-acceptance.mjs",
    # The harness spawns the Playwright CLI, which imports the ESM specs.
    # Node's ESM resolver ignores the rules_js fs patches while CommonJS
    # honours them, so under linux-sandbox the runner and the specs loaded
    # two Playwright copies. Unpatched, both resolve the same files.
    patch_node_fs = False,
    env = {
        "GF_BROWSER_SMOKE_BUILD_DIR": "$(rootpath :build)",
        "GF_RBE_CHROMIUM_EXECUTABLE": "/bin/chromium",
        "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD": "1",
    },
    # Run alone when local so software rendering does not contend with the
    # other tests; remote execution remains eligible.
    tags = [
        "browser-acceptance",
        "exclusive-if-local",
    ],
    timeout = "long",
)

# Every e2e spec (R583, TIN-7477): the 27 e2e/*.spec.ts files over the same
# declared //:build and loopback harness as //:browser_smoke_test, with the
# Chromium that //tools/chromium resolves (the Nix store Chromium of a lab
# host; `just chromium-pin`). It replaces the host `pnpm exec playwright test`
# lane. Local only: the Nix Chromium is a host path, never an action input.
js_test(
    name = "e2e_test",
    args = [
        "--config",
        "e2e.config.ts",
        "--chromium-env",
        "GF_E2E_CHROMIUM_EXECUTABLE",
        "--revision-env",
        "GF_E2E_CHROMIUM_REVISION",
        "--label",
        "every e2e spec",
        "--deadline-ms",
        "3420000",
    ],
    data = [
        ":app_srcs",
        ":build",
        ":e2e_srcs",
        ":node_modules/@playwright/test",
    ],
    entry_point = "e2e/bazel/run-browser-acceptance.mjs",
    # As for //:browser_smoke_test: the Playwright CLI imports the ESM specs,
    # and only an unpatched fs gives the runner and the specs one copy.
    patch_node_fs = False,
    env = {
        "FONTCONFIG_FILE": "$(GF_E2E_FONTCONFIG_FILE)",
        "GF_BROWSER_SMOKE_BUILD_DIR": "$(rootpath :build)",
        "GF_E2E_CHROMIUM_EXECUTABLE": "$(GF_E2E_CHROMIUM_EXECUTABLE)",
        "GF_E2E_CHROMIUM_REVISION": "$(GF_E2E_CHROMIUM_REVISION)",
        "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD": "1",
    },
    # Local only, through `local` and not a no-remote-exec tag: rules_js
    # copies the tags onto every copy-to-bin action, which would then differ
    # from //:browser_smoke_test's copies of the same specs and sources.
    local = True,
    tags = [
        "browser-acceptance",
        "exclusive-if-local",
        "manual",
    ],
    timeout = "eternal",
    toolchains = ["//tools/chromium:resolved"],
)

# Editors, the TypeScript server and `just typecheck-watch` (R583): a
# node_modules/ linked into the Bazel package store, plus copies of the
# SvelteKit $app and .svelte-kit trees. See tools/bazel/ide_setup.mjs.
js_binary(
    name = "ide_setup",
    data = [
        ":node_modules",
        # The two first-party modules link outside npm_link_all_packages.
        ":node_modules/@tummycrypt/tinyvectors",
        ":node_modules/@tummycrypt/vite-plugin-a11y",
        ":sveltekit_types",
    ],
    entry_point = "//tools/bazel:ide_setup",
    patch_node_fs = False,
    tags = ["manual"],
)

# The four manifest builders, writing into the checkout (R577). Each
# *_drift_test above runs the same script read-only.
[
    js_binary(
        name = name + "_write",
        args = ["./scripts/build-%s.mjs" % script],
        data = [
            "scripts/build-%s.mjs" % script,
            ":app_srcs",
            ".prettierrc",
            "tinyland.repo.json",
            ":node_modules/prettier",
            ":node_modules/prettier-plugin-svelte",
            ":node_modules/svelte",
        ],
        entry_point = "//tools/bazel:in_workspace",
        patch_node_fs = False,
        # `bazel run` only. No no-remote-exec tag: rules_js would copy it onto
        # the copy-to-bin actions the drift tests share.
        tags = ["manual"],
    )
    for name, script in [
        ("source_map", "source-map"),
        ("log_manifest", "log-manifest"),
        ("goals_manifest", "goals-manifest"),
        ("hours_manifest", "hours-manifest"),
    ]
]

# Served-artifact proof for the tinyvectors pin (TIN-4339). MODULE.bazel is
# the only resolution of the brand-vectors package; a build made off-fabric can
# still bundle a stray node_modules copy of another release with every other
# check green. This reads the declared client chunks and proves the bundled
# release's distinctive literal matches the pin. No browser, no server.
js_test(
    name = "served_tinyvectors_test",
    args = [
        "$(rootpath :build)",
        "--module",
        "$(rootpath MODULE.bazel)",
    ],
    data = [
        "MODULE.bazel",
        ":build",
    ],
    entry_point = "scripts/check-served-tinyvectors.mjs",
    timeout = "short",
)

test_suite(
    name = "ci_validation_suite",
    tests = [
        ":bazel_output_contract_test",
        ":browser_smoke_test",
        ":current_source_secret_scan_test",
        ":eslint_test",
        ":goals_manifest_drift_test",
        ":hours_manifest_drift_test",
        ":log_manifest_drift_test",
        ":prettier_check_test",
        ":served_tinyvectors_test",
        ":site_draft_compiler_test",
        ":source_map_drift_test",
        ":svelte_check_canary_test",
        ":svelte_check_test",
        ":unit_tests",
        ":workflow_validation_test",
    ],
)

test_suite(
    name = "lint_suite",
    tests = [":eslint_test", ":prettier_check_test"],
)

pkg_tar(
    name = "deployment_bundle",
    extension = "tar.gz",
    package_dir = "build",
    srcs = [":scanned_build"],
    strip_prefix = "scanned-build",
    tags = ["deployment-bundle-packaging"],
    visibility = ["//visibility:public"],
)

