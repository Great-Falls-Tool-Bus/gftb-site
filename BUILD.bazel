"""Finite Bazel graph for the Great Falls Tool Bus static microsite."""

load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_run_binary", "js_test")
load("@aspect_rules_js//npm:defs.bzl", "npm_link_package")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//:eslint/package_json.bzl", eslint_bin = "bin")
load("@npm//:prettier/package_json.bzl", prettier_bin = "bin")
load("@rules_python//python:defs.bzl", "py_test")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//:gitleaks_test.bzl", "actionlint_test", "gitleaks_test")
load("//:deployment_layer.bzl", "source_marker")

npm_link_all_packages(name = "node_modules")

# Bazel is the only carrier for this first-party Vite plugin.
npm_link_package(
    name = "node_modules/@tummycrypt/vite-plugin-a11y",
    src = "@tummycrypt_vite_plugin_a11y//:pkg",
)

# Bazel is likewise the only carrier for the TinyVectors brand background
# (Bazel-only ingestion; scripts/check-inhouse-package-parity.py enforces
# the bazel_dep + npm_link_package pairing and the absence of any npm
# specifier).
npm_link_package(
    name = "node_modules/@tummycrypt/tinyvectors",
    src = "@tummycrypt_tinyvectors//:pkg",
)

APP_NPM_PACKAGES = [
    ":node_modules/@fontsource-variable/fira-code",
    ":node_modules/@fontsource-variable/fraunces",
    ":node_modules/@fontsource/crimson-pro",
    ":node_modules/@fontsource/inter",
    ":node_modules/@skeletonlabs/skeleton",
    ":node_modules/@skeletonlabs/skeleton-svelte",
    ":node_modules/@sveltejs/adapter-static",
    ":node_modules/@sveltejs/kit",
    ":node_modules/@sveltejs/vite-plugin-svelte",
    ":node_modules/@tailwindcss/vite",
    ":node_modules/@types/node",
    ":node_modules/mdsvex",
    ":node_modules/rollup-plugin-visualizer",
    ":node_modules/shiki",
    ":node_modules/svelte",
    ":node_modules/tailwindcss",
    ":node_modules/typescript",
    ":node_modules/vite",
    ":node_modules/@tummycrypt/tinyvectors",
    ":node_modules/@tummycrypt/vite-plugin-a11y",
]

LINT_NPM_PACKAGES = [
    ":node_modules/@eslint/js",
    ":node_modules/eslint",
    ":node_modules/eslint-config-prettier",
    ":node_modules/eslint-plugin-svelte",
    ":node_modules/globals",
    ":node_modules/prettier",
    ":node_modules/prettier-plugin-svelte",
    ":node_modules/svelte",
    ":node_modules/typescript",
    ":node_modules/typescript-eslint",
]

TYPECHECK_NPM_PACKAGES = APP_NPM_PACKAGES + [
    ":node_modules/svelte-check",
    ":node_modules/vitest",
]

UNIT_TEST_NPM_PACKAGES = APP_NPM_PACKAGES + [
    ":node_modules/@vitest/coverage-v8",
    ":node_modules/vitest",
]

filegroup(
    name = "app_srcs",
    srcs = glob(
        [
            "src/**",
            "static/**",
            "scripts/bazel/**/*.mjs",
            # Acceptance-test-only modules the unit suite imports (leak scanner
            # and WCAG colour maths). They live outside src/lib so
            # shipped code cannot reach them, but //:unit_tests must.
            "scripts/lib/**/*.mjs",
            "scripts/lib/**/*.test.mts",
            "scripts/lib/**/*.json",
        ],
        allow_empty = True,
    ) + [
        ".npmrc",
        "package.json",
        # src/lib/leak-scan.test.ts asserts this stays a THIN runner over
        # scripts/lib/leak-scan.mjs, so the workspace has to carry it.
        "scripts/check-build-output.mjs",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "svelte.config.js",
        "tsconfig.json",
        "vite.config.ts",
        "vitest.config.ts",
    ],
)

filegroup(
    name = "format_srcs",
    srcs = glob(
        [
            ".agents/**/*.yaml",
            ".github/**/*.json",
            ".github/**/*.yaml",
            ".github/**/*.yml",
            "docs/**/*.json",
            "e2e/**/*.mjs",
            "e2e/**/*.ts",
            "scripts/**/*.js",
            "scripts/**/*.json",
            "scripts/**/*.mjs",
            "scripts/**/*.mts",
            "src/**/*.css",
            "src/**/*.html",
            "src/**/*.js",
            "src/**/*.json",
            "src/**/*.svelte",
            "src/**/*.svx",
            "src/**/*.ts",
        ],
        allow_empty = True,
    ) + [
        ".prettierignore",
        ".prettierrc",
        "eslint.config.ts",
        "package.json",
        "pnpm-workspace.yaml",
        "svelte.config.js",
        "tinyland.repo.json",
        "tsconfig.json",
        "vite.config.ts",
        "vitest.config.ts",
    ],
)

filegroup(
    name = "e2e_srcs",
    srcs = glob(["e2e/**"], allow_empty = True),
)

# The v4 validation action carries its own exact source capsule, so secret
# scanning becomes a hermetic Bazel test inside the same REAPI action rather
# than a second runner job. Ported from greatfallstoolbus.org
# (gitleaks_test.bzl + multitool.lock.json), adapted to this repo's tree.
filegroup(
    name = "current_source_secret_scan_srcs",
    srcs = [
        ".bazelignore",
        ".bazelrc",
        ".bazelversion",
        ".editorconfig",
        ".envrc",
        ".gitignore",
        ".gitleaks.toml",
        ".gitleaksignore",
        ".npmrc",
        ".nvmrc",
        ".prettierignore",
        ".prettierrc",
        "AGENTS.md",
        "BUILD.bazel",
        "Caddyfile",
        "CLAUDE.md",
        "Justfile",
        "LICENSE",
        "LICENSE-content",
        "MODULE.bazel",
        "MODULE.bazel.lock",
        "NOTICE",
        "README.md",
        "SECURITY.md",
        "deployment_layer.bzl",
        "eslint.config.ts",
        "flake.lock",
        "flake.nix",
        "gitleaks_test.bzl",
        "multitool.lock.json",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "svelte.config.js",
        "tinyland.repo.json",
        "tsconfig.json",
        "vite.config.ts",
        "vitest.config.ts",
    ] + glob(
        [
            ".agents/**",
            ".github/**",
            "docs/**",
            "e2e/**",
            "scripts/**",
            "src/**",
            "static/**",
        ],
        allow_empty = True,
        exclude = [
            "**/.DS_Store",
            "**/__pycache__/**",
        ],
    ),
)

# The v4 validate action carries the secret scan inside the same finite Bazel
# action graph. It uses a hermetic, platform-pinned gitleaks binary and needs no
# second runner job or repository-local lifecycle wrapper.
gitleaks_test(
    name = "current_source_secret_scan_test",
    timeout = "short",
    srcs = [":current_source_secret_scan_srcs"],
    config = ".gitleaks.toml",
)

# Workflow syntax is part of the protected v4 source contract. Keep actionlint
# inside the finite test graph with a checksummed multitool binary instead of
# depending on a runner-installed executable.
filegroup(
    name = "workflow_validation_srcs",
    srcs = glob(
        [".github/workflows/*.yml"],
        allow_empty = False,
    ),
)

actionlint_test(
    name = "workflow_validation_test",
    srcs = [":workflow_validation_srcs"],
    timeout = "short",
)

js_binary(
    name = "sveltekit_sync_bin",
    data = APP_NPM_PACKAGES,
    entry_point = "scripts/bazel/run-sveltekit-sync.mjs",
)

js_run_binary(
    name = "sveltekit_types",
    srcs = [":app_srcs"],
    out_dirs = [".svelte-kit"],
    tool = ":sveltekit_sync_bin",
)

copy_to_directory(
    name = "app_workspace",
    srcs = [
        ":app_srcs",
        ":sveltekit_types",
        # The supply-chain seams src/lib/brand-vectors-motion-contract.test.ts
        # and src/lib/house-stack-contract.test.ts read from the workspace
        # root: the bazel_dep pin, the immutable registry pin, and the lock
        # entry that binds them together.
        ".bazelrc",
        "MODULE.bazel",
        "MODULE.bazel.lock",
    ],
    hardlink = "off",
    root_paths = ["."],
)

js_test(
    name = "svelte_check_test",
    data = [":app_srcs", ":sveltekit_types"] + TYPECHECK_NPM_PACKAGES,
    entry_point = "scripts/bazel/run-svelte-check.mjs",
    timeout = "long",
)

eslint_bin.eslint_test(
    name = "eslint_test",
    args = ["."],
    data = [":app_srcs", ":e2e_srcs", ":sveltekit_types", "eslint.config.ts"] + LINT_NPM_PACKAGES,
    timeout = "moderate",
)

prettier_bin.prettier_test(
    name = "prettier_check_test",
    args = ["--check", "."],
    data = [":format_srcs", ":node_modules/prettier", ":node_modules/prettier-plugin-svelte", ":node_modules/svelte"],
    timeout = "short",
)

js_binary(
    name = "vite_build_bin",
    data = APP_NPM_PACKAGES,
    entry_point = "scripts/bazel/run-vite-build.mjs",
)

js_run_binary(
    name = "build",
    args = [
        "--workspace",
        "$(rootpath :app_workspace)",
        "--source-marker",
        "$(rootpath :deployment_source_marker)",
        "--output-dir",
        "build",
    ],
    srcs = [":app_workspace", ":deployment_source_marker"],
    out_dirs = ["build"],
    patch_node_fs = False,
    stamp = 0,
    tags = ["sveltekit-app-build"],
    tool = ":vite_build_bin",
    visibility = ["//visibility:public"],
)

# Publication is allowed to consume only this copied-and-scanned TreeArtifact.
# The copy and leak scan happen in one Bazel action: a scan failure produces no
# output, so //:deployment_bundle cannot package an unscanned //:build tree.
js_binary(
    name = "leak_scan_build_bin",
    data = [":app_srcs"],
    entry_point = "scripts/check-build-output.mjs",
)

js_run_binary(
    name = "scanned_build",
    args = [
        "$(rootpath :build)",
        "--copy-to",
        "scanned-build",
    ],
    out_dirs = ["scanned-build"],
    patch_node_fs = False,
    srcs = [":build"],
    tool = ":leak_scan_build_bin",
    visibility = ["//visibility:public"],
)

js_run_binary(
    name = "analyze",
    args = [
        "--workspace",
        "$(rootpath :app_workspace)",
        "--source-marker",
        "$(rootpath :deployment_source_marker)",
        "--output-dir",
        "build-analyze",
        "--analyze",
        "--analyze-output",
        ".bundle-stats/stats.html",
    ],
    srcs = [":app_workspace", ":deployment_source_marker"],
    out_dirs = ["build-analyze", ".bundle-stats"],
    patch_node_fs = False,
    stamp = 0,
    tool = ":vite_build_bin",
    visibility = ["//visibility:public"],
)

js_test(
    name = "unit_tests",
    data = [":app_workspace", "scripts/bazel/prepare-sveltekit-types.mjs"] + UNIT_TEST_NPM_PACKAGES,
    args = ["--workspace", "$(rootpath :app_workspace)", "run", "--reporter=verbose", "--config", "vitest.config.ts"],
    entry_point = "scripts/bazel/run-vitest.mjs",
    tags = ["sveltekit-unit-tests", "vitest"],
    visibility = ["//visibility:public"],
)

js_binary(
    name = "vitest_coverage_bin",
    data = ["scripts/bazel/prepare-sveltekit-types.mjs"] + UNIT_TEST_NPM_PACKAGES,
    entry_point = "scripts/bazel/run-vitest.mjs",
)

js_run_binary(
    name = "unit_test_coverage",
    args = [
        "--workspace",
        "$(rootpath :app_workspace)",
        "--coverage-output",
        "coverage",
        "run",
        "--reporter=verbose",
        "--config",
        "vitest.config.ts",
    ],
    out_dirs = ["coverage"],
    srcs = [":app_workspace"],
    tags = ["manual", "no-remote-exec"],
    tool = ":vitest_coverage_bin",
)

# Generated source manifests are checked read-only inside the Bazel sandbox.
# Each test executes the same generator used by its Just build recipe and
# compares the deterministic bytes to the committed output.
js_test(
    name = "source_map_drift_test",
    args = ["--check"],
    data = [
        ":app_srcs",
        "tinyland.repo.json",
    ],
    entry_point = "scripts/build-source-map.mjs",
    timeout = "short",
)

js_test(
    name = "log_manifest_drift_test",
    args = ["--check"],
    data = [
        ":app_srcs",
        ".prettierrc",
        ":node_modules/prettier",
        ":node_modules/prettier-plugin-svelte",
        ":node_modules/svelte",
    ],
    entry_point = "scripts/build-log-manifest.mjs",
    timeout = "short",
)

js_test(
    name = "goals_manifest_drift_test",
    args = ["--check"],
    data = [
        ":app_srcs",
        ".prettierrc",
        ":node_modules/prettier",
        ":node_modules/prettier-plugin-svelte",
        ":node_modules/svelte",
    ],
    entry_point = "scripts/build-goals-manifest.mjs",
    timeout = "short",
)

py_test(
    name = "bazel_output_contract_test",
    srcs = [
        "scripts/bazel_output.py",
        "scripts/test-bazel-cutover-contracts.py",
    ],
    main = "scripts/test-bazel-cutover-contracts.py",
    imports = ["scripts"],
    data = [
        ":current_source_secret_scan_srcs",
        ".github/lanes.json",
        ".github/workflows/ci.yml",
        "BUILD.bazel",
        "Justfile",
        "MODULE.bazel",
        "docs/schemas/tinyland-repo-manifest.v2.schema.json",
        "flake.nix",
        "package.json",
        "scripts/check-inhouse-package-parity.py",
        "scripts/validate-skills.py",
        "static/qr/greatfallstoolbus-apex.svg",
        "tinyland.repo.json",
    ],
)

# Chromium loopback smoke over the declared //:build output, per
# GloriousFlywheel's browser-RBE candidate template (examples/web-rbe/*) and
# public-docs/browser-rbe-candidate-guide.md: build through declared Bazel
# inputs, serve that output from inside the test action on 127.0.0.1, launch
# the pre-provisioned worker Chromium named by GF_RBE_CHROMIUM_EXECUTABLE via
# playwright's explicit executablePath, with writable HOME/XDG dirs under test
# scratch and no action-time browser download (MODULE.bazel pins
# PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD at npm lifecycle time).
#
# This browser candidate is deliberately outside the two-action v4 plan.
# `manual` keeps suites and wildcards from selecting it until a browser-capable
# action and result lifecycle are ratified; it is not a local fallback for PRE
# or LOOK.
#
# GF_BROWSER_SMOKE_REQUIRE_PROVENANCE=1: //:build consumes only the exact source
# marker projected from the GF-bound BUILD_EMBED_LABEL, not whole status files.
# Missing or malformed identity fails the build; disabling the browser assertion
# cannot bypass that build boundary.
js_test(
    name = "browser_smoke_test",
    data = [
        ":build",
        ":e2e_srcs",
        ":node_modules/@playwright/test",
    ],
    entry_point = "e2e/bazel/run-browser-smoke.mjs",
    env = {
        "GF_BROWSER_SMOKE_BUILD_DIR": "$(rootpath :build)",
        "GF_BROWSER_SMOKE_PATH": "/",
        "GF_BROWSER_SMOKE_TITLE": "Great Falls Tool Bus",
        "GF_BROWSER_SMOKE_REQUIRE_PROVENANCE": "1",
    },
    tags = [
        "browser-smoke",
        "manual",
    ],
    timeout = "moderate",
)

test_suite(
    name = "ci_validation_suite",
    tests = [
        ":bazel_output_contract_test",
        ":current_source_secret_scan_test",
        ":eslint_test",
        ":goals_manifest_drift_test",
        ":log_manifest_drift_test",
        ":prettier_check_test",
        ":source_map_drift_test",
        ":svelte_check_test",
        ":unit_tests",
        ":workflow_validation_test",
    ],
)

test_suite(
    name = "lint_suite",
    tests = [":eslint_test", ":prettier_check_test"],
)

source_marker(
    name = "deployment_source_marker",
)

# GF-I09 consumes this exact, uncompressed OCI application layer. The public
# site bytes can enter only through //:scanned_build; Caddy configuration and
# the exact source marker are first-party configuration added after that scan.
pkg_tar(
    name = "deployment_bundle",
    allow_duplicates_from_deps = False,
    allow_duplicates_with_different_content = False,
    empty_dirs = ["tmp"],
    extension = "tar",
    modes = {
        "etc/caddy/Caddyfile": "0444",
        "srv/health.sha": "0444",
        "tmp": "1777",
    },
    remap_paths = {
        "Caddyfile": "etc/caddy/Caddyfile",
        "health.sha": "srv/health.sha",
        "scanned-build": "srv",
    },
    srcs = [
        ":deployment_source_marker",
        ":scanned_build",
        "Caddyfile",
    ],
    tags = ["deployment-bundle-packaging"],
    package_dir = "/",
    visibility = ["//visibility:public"],
)

exports_files(
    [
        "MODULE.bazel",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "scripts/bazel/prepare-sveltekit-types.mjs",
        "scripts/bazel/run-svelte-check.mjs",
        "scripts/bazel/run-sveltekit-sync.mjs",
        "scripts/bazel/run-vitest.mjs",
        "scripts/bazel/run-vite-build.mjs",
        "svelte.config.js",
        "tsconfig.json",
        "vite.config.ts",
        "vitest.config.ts",
    ],
    visibility = ["//visibility:public"],
)
