# Explicit load, not native-rule autoload: autoload only applies within a
# Bazel invocation's MAIN repository, never to this package when it is
# consumed as an external module via bazel_dep/git_override - which is
# this module's own documented consumption path (README "Consuming
# through the registry"). Without this load, EVERY external consumer's
# `bazel build`/`bazel run` on ANY target in this package fails at load
# time with "name 'sh_test' is not defined", including the harmless
# :module_srcs filegroup - discovered empirically consuming this module
# from MMS #71/TIN-489, 2026-08-08. Needs the matching
# bazel_dep(rules_shell) in this package's own MODULE.bazel.
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

# The carrier loop body (mounted into the CronJob via ConfigMap by tofu/main.tf).
filegroup(
    name = "carrier_script",
    srcs = ["carrier/converge-agent.sh"],
)

# The CronJob manifest template rendered per tenant by tofu/main.tf.
filegroup(
    name = "cronjob_template",
    srcs = ["templates/converge-agent-cronjob.yaml.tftpl"],
)

# The tofu module a tenant stack instantiates (module block source).
filegroup(
    name = "tofu_module_srcs",
    srcs = glob(["tofu/*.tf"]),
)

# The tenant-side contract laws, shipped WITH the module so a tenant that
# materializes the module also materializes the checkers that judge its own
# declarations. This is the consolidation: one implementation of each law,
# imported by the module's own suite and by the adopter's copy of
# scripts/test-converge-agent-contract.example.py. A tenant that reimplements
# a checker has forked the law.
filegroup(
    name = "tenant_contract",
    srcs = ["contract/tenant_contract.py"],
)

# Everything a consumer materializes into its stack. Consumption is
# reference-not-copy: bazel_dep on this module, then copy_to_directory /
# pkg_tar of this filegroup into the consuming stack's build output — see
# README.md. Checking these files into a site repository is drift.
filegroup(
    name = "module_srcs",
    srcs = [
        "README.md",
        ":carrier_script",
        ":cronjob_template",
        ":tenant_contract",
        ":tofu_module_srcs",
    ],
)

# Mutation-proving contract of the module and of any N-tenant instantiation
# set (same sh_test-over-python convention as the scaffold root
# application_owner_overlay_contract_test). The kill-switch law is proven by
# EXECUTING the shipped loop body with a stubbed toolchain, so the test needs
# bash, jq, and git on PATH (deliberately loud-fails, never skips, when they
# are absent); the standing CI gates run it via plain python3 — see
# .github/workflows/ci.yml carrier-module-contract and check-conformance 17b.
sh_test(
    name = "contract_test",
    size = "small",
    srcs = ["tests/test_converge_agent_contract.py"],
    data = [":module_srcs"],
    tags = [
        "agent-contract",
        "no-remote-exec",
    ],
)
