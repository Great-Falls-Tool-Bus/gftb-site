{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "GFTB Tinyland repository manifest",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema_version",
		"repo",
		"taxonomy",
		"contracts",
		"boundaries",
		"authorities",
		"supply_chain"
	],
	"properties": {
		"$schema": { "type": "string" },
		"schema_version": { "const": 1 },
		"scaffold_tag": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
		"repo": {
			"type": "object",
			"additionalProperties": false,
			"required": ["name", "github", "domain", "description"],
			"properties": {
				"name": { "const": "gftb-site" },
				"github": { "const": "Great-Falls-Tool-Bus/gftb-site" },
				"domain": { "const": "greatfallstoolbus.org" },
				"description": { "type": "string", "minLength": 12 }
			}
		},
		"taxonomy": {
			"type": "object",
			"additionalProperties": false,
			"required": ["primary_role", "spawned_repo_role", "layers"],
			"properties": {
				"primary_role": { "const": "static-spoke" },
				"spawned_repo_role": { "const": "static-spoke" },
				"layers": {
					"type": "array",
					"uniqueItems": true,
					"items": { "enum": ["org-wide-repo-contract", "bazel-package-cache-rbe", "static-spoke"] },
					"contains": { "const": "static-spoke" }
				}
			}
		},
		"contracts": {
			"type": "object",
			"additionalProperties": false,
			"required": ["agent_contract", "just", "nix", "github_actions", "secrets_scan", "conformance"],
			"properties": {
				"agent_contract": { "const": "AGENTS.md" },
				"just": { "const": "Justfile" },
				"nix": { "const": "flake.nix" },
				"github_actions": { "const": ".github/workflows" },
				"secrets_scan": { "const": "gitleaks" },
				"conformance": { "const": "just conformance" }
			}
		},
		"boundaries": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"owns_runtime_backend",
				"owns_auth",
				"owns_payments",
				"owns_activitypub_delivery",
				"owns_live_broker_fetch",
				"owns_static_projection_ingest",
				"owns_gitops_apply",
				"owns_cloudflare_mutation",
				"owns_bazel_module_authority"
			],
			"properties": {
				"owns_runtime_backend": { "const": false },
				"owns_auth": { "const": false },
				"owns_payments": { "const": false },
				"owns_activitypub_delivery": { "const": false },
				"owns_live_broker_fetch": { "const": false },
				"owns_static_projection_ingest": { "const": false },
				"owns_gitops_apply": { "const": false },
				"owns_cloudflare_mutation": { "const": false },
				"owns_bazel_module_authority": { "const": false }
			}
		},
		"authorities": {
			"type": "object",
			"additionalProperties": false,
			"required": ["content_authority", "ci_templates", "cache_rbe_authority", "package_registry"],
			"properties": {
				"content_authority": { "type": "string", "minLength": 1 },
				"ci_templates": { "const": "tinyland-inc/ci-templates" },
				"cache_rbe_authority": { "const": "tinyland-inc/GloriousFlywheel" },
				"package_registry": { "const": "tinyland-inc/bazel-registry" }
			}
		},
		"supply_chain": {
			"type": "object",
			"additionalProperties": false,
			"required": ["sbom"],
			"properties": {
				"sbom": {
					"type": "object",
					"additionalProperties": false,
					"required": ["status", "formats"],
					"properties": {
						"status": { "enum": ["recipe-available", "generated"] },
						"formats": { "const": ["CycloneDX JSON", "SPDX JSON"] },
						"notes": { "type": "string" }
					}
				}
			}
		}
	}
}
