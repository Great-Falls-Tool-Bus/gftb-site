{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://raw.githubusercontent.com/tinyland-inc/site.scaffold/main/docs/schemas/application-owner-overlay.schema.json",
	"title": "Tinyland application owner-overlay binding",
	"description": "A generic, single-application authority contract between an application source repository, its dedicated owner overlay, and shared substrate dependencies. This document declares source authority only; it does not install or apply infrastructure.",
	"type": "object",
	"required": [
		"schema_version",
		"application_source",
		"owner_overlay",
		"application_binding",
		"capabilities",
		"shared_substrates"
	],
	"additionalProperties": false,
	"properties": {
		"$schema": {
			"type": "string",
			"description": "Editor-support hint pointing at this schema."
		},
		"$comment": {
			"type": "string",
			"description": "Free-form source comment. It grants no authority."
		},
		"schema_version": {
			"const": 1
		},
		"application_source": {
			"$ref": "#/$defs/applicationSource"
		},
		"owner_overlay": {
			"$ref": "#/$defs/ownerOverlay"
		},
		"application_binding": {
			"$ref": "#/$defs/applicationBinding"
		},
		"capabilities": {
			"$ref": "#/$defs/capabilities"
		},
		"shared_substrates": {
			"$ref": "#/$defs/sharedSubstrates"
		}
	},
	"$defs": {
		"repository": {
			"type": "string",
			"pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
		},
		"defaultBranch": {
			"type": "string",
			"minLength": 1,
			"maxLength": 255,
			"pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
		},
		"sourceRole": {
			"description": "Application-capable subset of the canonical repoRole enum in tinyland-repo-manifest.schema.json. Contract tests require this set to remain a subset.",
			"enum": ["static-spoke", "app-stateful-spoke", "mothership"]
		},
		"workflowPath": {
			"type": "string",
			"pattern": "^\\.github/workflows/[A-Za-z0-9_.-]+\\.(?:yml|yaml)$"
		},
		"artifactRepository": {
			"type": "string",
			"pattern": "^ghcr\\.io/[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)+$"
		},
		"relativeJsonPath": {
			"type": "string",
			"pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+\\.json$"
		},
		"jsonPointer": {
			"type": "string",
			"pattern": "^(?:/(?:[^~/]|~[01])*)+$"
		},
		"applicationSource": {
			"type": "object",
			"required": ["repository", "role", "default_branch", "artifact_workflow"],
			"additionalProperties": false,
			"properties": {
				"repository": {
					"$ref": "#/$defs/repository"
				},
				"role": {
					"$ref": "#/$defs/sourceRole"
				},
				"default_branch": {
					"$ref": "#/$defs/defaultBranch"
				},
				"artifact_workflow": {
					"$ref": "#/$defs/workflowPath"
				}
			}
		},
		"bindingReceipt": {
			"description": "A syntactically immutable claim pointing at a prior overlay revision. Source validation does not dereference or prove the claim.",
			"type": "object",
			"required": ["repository", "commit_sha", "path", "document_pointer"],
			"additionalProperties": false,
			"properties": {
				"repository": {
					"$ref": "#/$defs/repository"
				},
				"commit_sha": {
					"type": "string",
					"pattern": "^(?!0{40}$)[0-9a-f]{40}$"
				},
				"path": {
					"$ref": "#/$defs/relativeJsonPath"
				},
				"document_pointer": {
					"const": "/application_binding",
					"$ref": "#/$defs/jsonPointer"
				}
			}
		},
		"ownerOverlay": {
			"type": "object",
			"required": ["repository", "authority_class", "binding_status"],
			"additionalProperties": false,
			"properties": {
				"repository": {
					"$ref": "#/$defs/repository"
				},
				"authority_class": {
					"const": "application-owner-overlay"
				},
				"binding_status": {
					"enum": ["declared", "receipt-recorded"]
				},
				"binding_receipt": {
					"$ref": "#/$defs/bindingReceipt"
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"binding_status": {
								"const": "receipt-recorded"
							}
						},
						"required": ["binding_status"]
					},
					"then": {
						"required": ["binding_receipt"]
					},
					"else": {
						"not": {
							"required": ["binding_receipt"]
						}
					}
				}
			]
		},
		"applicationBinding": {
			"type": "object",
			"required": [
				"source_repository",
				"source_role",
				"application_slug",
				"default_branch",
				"artifact_repository",
				"artifact_workflow"
			],
			"additionalProperties": false,
			"properties": {
				"source_repository": {
					"$ref": "#/$defs/repository"
				},
				"source_role": {
					"$ref": "#/$defs/sourceRole"
				},
				"application_slug": {
					"type": "string",
					"pattern": "^[a-z][a-z0-9-]{1,62}$"
				},
				"default_branch": {
					"$ref": "#/$defs/defaultBranch"
				},
				"artifact_repository": {
					"$ref": "#/$defs/artifactRepository"
				},
				"artifact_workflow": {
					"$ref": "#/$defs/workflowPath"
				}
			}
		},
		"capabilities": {
			"type": "object",
			"required": [
				"owns_application_image_pins",
				"owns_application_state",
				"owns_secret_declarations",
				"owns_application_workloads",
				"owns_protected_plan_apply",
				"owns_reaping",
				"owns_runtime_receipts",
				"owns_application_zone_dns",
				"owns_application_database",
				"owns_application_mail_policy"
			],
			"additionalProperties": false,
			"properties": {
				"owns_application_image_pins": {
					"const": true
				},
				"owns_application_state": {
					"const": true
				},
				"owns_secret_declarations": {
					"const": true
				},
				"owns_application_workloads": {
					"const": true
				},
				"owns_protected_plan_apply": {
					"const": true
				},
				"owns_reaping": {
					"const": true
				},
				"owns_runtime_receipts": {
					"const": true
				},
				"owns_application_zone_dns": {
					"type": "boolean"
				},
				"owns_application_database": {
					"type": "boolean"
				},
				"owns_application_mail_policy": {
					"type": "boolean"
				}
			}
		},
		"sharedAuthority": {
			"type": "object",
			"required": ["repository", "authority_class"],
			"additionalProperties": false,
			"properties": {
				"repository": {
					"$ref": "#/$defs/repository"
				},
				"authority_class": {
					"enum": [
						"consumer-neutral-cluster-substrate",
						"reusable-execution-products",
						"host-policy-and-credential-projection"
					]
				}
			}
		},
		"sharedSubstrates": {
			"type": "object",
			"required": ["cluster", "execution_products", "host_policy"],
			"additionalProperties": false,
			"properties": {
				"cluster": {
					"$ref": "#/$defs/sharedAuthority"
				},
				"execution_products": {
					"$ref": "#/$defs/sharedAuthority"
				},
				"host_policy": {
					"$ref": "#/$defs/sharedAuthority"
				}
			}
		}
	}
}
