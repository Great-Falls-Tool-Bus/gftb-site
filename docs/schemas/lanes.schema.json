{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "GFTB static-spoke lanes manifest",
	"type": "object",
	"additionalProperties": false,
	"required": ["schema_version", "spoke", "defaults", "lanes"],
	"properties": {
		"$schema": { "type": "string" },
		"schema_version": { "const": 1 },
		"spoke": {
			"type": "object",
			"additionalProperties": false,
			"required": ["name", "domain", "image_repository"],
			"properties": {
				"name": { "const": "gftb-site" },
				"domain": { "const": "greatfallstoolbus.org" },
				"image_repository": { "const": "ghcr.io/great-falls-tool-bus/gftb-site" }
			}
		},
		"defaults": {
			"type": "object",
			"additionalProperties": false,
			"required": ["runner_class", "ttl_hours", "flywheel_target_classes"],
			"properties": {
				"runner_class": { "const": "tinyland-nix" },
				"ttl_hours": { "type": "integer", "minimum": 1, "maximum": 720 },
				"flywheel_target_classes": {
					"type": "array",
					"uniqueItems": true,
					"items": { "enum": ["sveltekit-app-build", "sveltekit-unit-tests", "deployment-bundle-packaging"] }
				}
			}
		},
		"lanes": {
			"type": "array",
			"minItems": 1,
			"maxItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["name", "trigger", "theme", "snapshot_source", "e2e"],
				"properties": {
					"name": { "const": "default" },
					"trigger": { "const": "pull_request" },
					"theme": { "const": "gftb" },
					"snapshot_source": { "const": "checked-in" },
					"e2e": { "const": true }
				}
			}
		}
	}
}
