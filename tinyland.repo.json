{
	"$schema": "./docs/schemas/tinyland-repo-manifest.v2.schema.json",
	"schema_version": 2,
	"scaffold_origin": {
		"repository": "tinyland-inc/site.scaffold",
		"commit_sha": "28934488bcc40519eead43ca25e35ea04d89b13a"
	},
	"repo": {
		"name": "gftb-site",
		"github": "Great-Falls-Tool-Bus/gftb-site",
		"domain": "greatfallstoolbus.org",
		"description": "Public static microsite and reviewed daily log for the Great Falls Tool Bus.",
		"defaultBranch": "main"
	},
	"taxonomy": {
		"primary_role": "static-spoke",
		"layers": ["org-wide-repo-contract", "bazel-package-cache-rbe", "static-spoke"]
	},
	"enrollment": {
		"forgeScope": "Great-Falls-Tool-Bus",
		"organizationOverlay": "Great-Falls-Tool-Bus/great-falls-tool-bus-infra",
		"organizationOverlayRole": "organization-execution-overlay",
		"organizationOverlayComposition": "distinct"
	},
	"runtime_network": {
		"declarations": [
			{
				"purpose": "contact-submit",
				"module": "src/lib/components/ContactForm.svelte",
				"url": "https://forms.latoolb.us/api/contact",
				"method": "POST"
			}
		]
	},
	"contracts": {
		"agent_contract": "AGENTS.md",
		"just": "Justfile",
		"nix": "flake.nix",
		"github_actions": ".github/workflows",
		"secrets_scan": "gitleaks",
		"conformance": "just conformance"
	},
	"boundaries": {
		"owns_runtime_backend": false,
		"owns_auth": false,
		"owns_payments": false,
		"owns_activitypub_delivery": false,
		"owns_live_broker_fetch": false,
		"owns_static_projection_ingest": false,
		"owns_gitops_apply": false,
		"owns_cloudflare_mutation": false,
		"owns_bazel_module_authority": false,
		"owns_application_pins": false,
		"owns_application_state": false,
		"owns_secret_declarations": false,
		"owns_application_workloads": false,
		"owns_application_zone_dns": false,
		"owns_application_mail_policy": false,
		"owns_application_database": false,
		"owns_forge_app_installations": false,
		"owns_org_grants": false
	},
	"authorities": {
		"content_authority": "Great-Falls-Tool-Bus/gftb-site reviewed public SVX",
		"ci_templates": "tinyland-inc/ci-templates",
		"package_registry": "tinyland-inc/bazel-registry"
	},
	"supply_chain": {
		"sbom": {
			"status": "recipe-available",
			"formats": ["CycloneDX JSON", "SPDX JSON"],
			"notes": "Run `just sbom` to generate ignored local SBOM artifacts under build/sbom/. Publication should become a standard ci-templates or release artifact before status moves to generated."
		}
	}
}
