{
	"comment": [
		"Public-output leak rules. Shared by src/lib/leak-scan.ts (unit tested) and",
		"scripts/check-build-output.mjs (the just leak-scan gate over build/), so the",
		"rule text has exactly one home. Patterns are RegExp source strings; flags are",
		"applied per rule and 'g' is added by the scanner."
	],
	"rules": [
		{
			"id": "secret-pem-block",
			"description": "PEM private key or certificate block",
			"pattern": "-----BEGIN [A-Z ]*(PRIVATE KEY|CERTIFICATE)-----",
			"flags": "u"
		},
		{
			"id": "secret-ssh-key",
			"description": "OpenSSH private key material",
			"pattern": "ssh-(rsa|ed25519) AAAA[0-9A-Za-z+/]{32,}",
			"flags": "u"
		},
		{
			"id": "secret-cloud-access-key",
			"description": "cloud provider access key id",
			"pattern": "\\b(AKIA|ASIA)[0-9A-Z]{16}\\b",
			"flags": "u"
		},
		{
			"id": "secret-forge-token",
			"description": "code-forge or chat access token",
			"pattern": "\\b(ghp_[0-9A-Za-z]{36}|github_pat_[0-9A-Za-z_]{22,}|glpat-[0-9A-Za-z_-]{20}|xox[abprs]-[0-9A-Za-z-]{10,})\\b",
			"flags": "u"
		},
		{
			"id": "secret-json-web-token",
			"description": "signed JSON Web Token",
			"pattern": "\\beyJ[0-9A-Za-z_-]{10,}\\.eyJ[0-9A-Za-z_-]{10,}\\.[0-9A-Za-z_-]{10,}\\b",
			"flags": "u"
		},
		{
			"id": "secret-assignment",
			"description": "credential-shaped assignment",
			"pattern": "\\b(api[_-]?key|secret[_-]?key|access[_-]?token|client[_-]?secret|password|passwd)\\b\\s*[:=]\\s*[\"'][^\"'\\s]{12,}[\"']",
			"flags": "iu"
		},
		{
			"id": "kubeconfig-fragment",
			"description": "kubeconfig or cluster credential fragment",
			"pattern": "\\b(client-certificate-data|client-key-data|certificate-authority-data|current-context|kubeconfig|serviceaccount/token)\\b",
			"flags": "iu"
		},
		{
			"id": "internal-hostname",
			"description": "cluster-local, tailnet, or otherwise private hostname",
			"pattern": "\\b[a-z0-9-]+(?:\\.[a-z0-9-]+)*\\.(?:svc|cluster\\.local|ts\\.net|internal|intranet|lan|home\\.arpa)\\b",
			"flags": "iu"
		},
		{
			"id": "private-network-address",
			"description": "RFC1918, loopback, link-local, or CGNAT address",
			"pattern": "\\b(?:10(?:\\.\\d{1,3}){3}|172\\.(?:1[6-9]|2\\d|3[01])(?:\\.\\d{1,3}){2}|192\\.168(?:\\.\\d{1,3}){2}|127(?:\\.\\d{1,3}){3}|169\\.254(?:\\.\\d{1,3}){2}|100\\.(?:6[4-9]|[7-9]\\d|1[01]\\d|12[0-7])(?:\\.\\d{1,3}){2})\\b",
			"flags": "u"
		},
		{
			"id": "cache-or-executor-endpoint",
			"description": "build cache, remote executor, or gRPC endpoint literal",
			"pattern": "(?:grpcs?://|https?://[^\\s\"'<>)]*(?:bazel-cache|remote-cache|reapi|executor|buildbarn|buildfarm))",
			"flags": "iu"
		},
		{
			"id": "localhost-reference",
			"description": "localhost or a bound development port",
			"pattern": "\\blocalhost(?::\\d{1,5})?\\b|\\b0\\.0\\.0\\.0\\b",
			"flags": "iu"
		},
		{
			"id": "source-map-or-dev-artifact",
			"description": "source map or developer-only artefact leaked into the public build",
			"pattern": "sourceMappingURL|//# sourceURL|\\bnode_modules/|\\bllms\\.txt\\b|\\bagent-map\\.md\\b",
			"flags": "u"
		},
		{
			"id": "developer-filesystem-path",
			"description": "absolute path from a developer or CI machine",
			"pattern": "(?:/Users/[a-z0-9._-]+|/home/[a-z0-9._-]+|/private/var/[a-z0-9._/-]+|/root/|[A-Z]:\\\\Users\\\\)",
			"flags": "iu"
		},
		{
			"id": "internal-tracker-reference",
			"description": "issue tracker, pull request, commit, or repository pointer",
			"pattern": "\\bTIN-\\d+\\b|\\blinear\\.app\\b|\\bgithub\\.com/|\\bpull request\\b|\\bPR\\s*#\\d+\\b|\\b[0-9a-f]{40}\\b",
			"flags": "iu"
		},
		{
			"id": "private-personal-name",
			"description": "personal name beyond the single initial the bus host consented to",
			"pattern": "\\b(?:[A-Z]\\.\\s*[A-Z][a-z]{2,}|[A-Z][a-z]{2,}\\s+[A-Z]\\.\\s*[A-Z][a-z]{2,})\\b",
			"flags": "u"
		},
		{
			"id": "private-list-archive",
			"description": "archive link for the private keyholders role list",
			"pattern": "hyperkitty/list/keyholders@|/archives?/keyholders@|keyholders@[a-z0-9.-]+/(?:thread|message)",
			"flags": "iu"
		}
	],
	"allowedHosts": [
		"greatfallstoolbus.org",
		"latoolb.us",
		"lists.latoolb.us",
		"forms.latoolb.us",
		"altcha.org",
		"creativecommons.org",
		"fukuchi.org",
		"schema.org",
		"svelte.dev",
		"tailwindcss.com",
		"www.sitemaps.org",
		"www.w3.org"
	],
	"allowedMailboxes": ["keyholders@latoolb.us", "discuss@latoolb.us"]
}
