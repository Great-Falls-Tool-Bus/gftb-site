"""Chromium toolchain for //:e2e_test (R583, TIN-7477; critique N1).

The toolchain() targets are here, in the main repository, and
MODULE.bazel registers //tools/chromium:all. Resolving any other toolchain
(the Node toolchain of every js_test, for one) loads this package only, never
@chromium_nix, so //:lint_suite never fetches the Nix Chromium. The two
implementations are mutually exclusive through :source.
"""

load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load(":defs.bzl", "chromium_toolchain", "resolved_chromium")

toolchain_type(name = "toolchain_type")

# nix: a lab host (sting, neo, pzm) runs //:e2e_test against the pinned Nix
# store Chromium. gf_rbe: the GF provisioned /bin/chromium of
# rbe-linux-x86_64 (TIN-1131). //:browser_smoke_test keeps naming
# /bin/chromium directly and does not use this toolchain.
string_flag(
    name = "source",
    build_setting_default = "nix",
    values = [
        "gf_rbe",
        "nix",
    ],
)

config_setting(
    name = "source_nix",
    flag_values = {":source": "nix"},
)

config_setting(
    name = "source_gf_rbe",
    flag_values = {":source": "gf_rbe"},
)

chromium_toolchain(
    name = "gf_rbe_impl",
    executable = "/bin/chromium",
    source = "gf_rbe",
)

toolchain(
    name = "rbe_linux_x86_64",
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    target_settings = [":source_gf_rbe"],
    toolchain = ":gf_rbe_impl",
    toolchain_type = ":toolchain_type",
)

toolchain(
    name = "nix_host",
    target_settings = [":source_nix"],
    toolchain = "@chromium_nix//:impl",
    toolchain_type = ":toolchain_type",
)

resolved_chromium(
    name = "resolved",
    visibility = ["//:__pkg__"],
)

exports_files(["nix-paths.json"])
